rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for user authentication and data validation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Enhanced user profile validation with comprehensive checks
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'profile', 'onboarding', 'routine', 'settings', 'subscription', 'stats', 'metadata']) &&
             data.userId == request.auth.uid &&
             isValidProfileSection(data.profile) &&
             isValidOnboardingSection(data.onboarding) &&
             isValidRoutineSection(data.routine) &&
             isValidSettingsSection(data.settings) &&
             isValidSubscriptionSection(data.subscription) &&
             isValidStatsSection(data.stats) &&
             isValidMetadataSection(data.metadata);
    }
    
    function isValidProfileSection(profile) {
      return profile.email is string &&
             profile.email.matches('.*@.*\\..*') &&
             profile.timeZone is string &&
             profile.locale is string &&
             profile.locale.matches('[a-z]{2}(-[A-Z]{2})?');
    }
    
    function isValidOnboardingSection(onboarding) {
      return onboarding.isCompleted is bool &&
             (onboarding.isCompleted == false || 
              (onboarding.responses != null && isValidOnboardingResponses(onboarding.responses)));
    }
    
    function isValidOnboardingResponses(responses) {
      return responses.currentWakeTime is string &&
             responses.currentWakeTime.matches('[0-2][0-9]:[0-5][0-9]') &&
             responses.workType in ['Employee', 'Employer', 'Student', 'Freelancer'] &&
             responses.workStyle in ['Office', 'Remote', 'Hybrid', 'Not applicable'] &&
             responses.productivityRating is number &&
             responses.productivityRating >= 1 &&
             responses.productivityRating <= 10;
    }
    
    function isValidRoutineSection(routine) {
      return routine.wakeTime is string &&
             routine.wakeTime.matches('[0-2][0-9]:[0-5][0-9]') &&
             routine.routineDuration is number &&
             routine.routineDuration >= 0 &&
             routine.routineDuration <= 180 &&
             routine.selectedTasks is list &&
             routine.selectedTasks.size() <= 10 &&
             isValidSelectedTasks(routine.selectedTasks);
    }
    
    function isValidSelectedTasks(tasks) {
      return tasks.size() > 0 &&
             tasks.hasAll([
               {'taskId': 'drink_water', 'order': 1, 'isEnabled': true},
               {'taskId': 'no_phone_usage', 'order': 2, 'isEnabled': true},
               {'taskId': 'sunlight_exposure', 'order': 3, 'isEnabled': true},
               {'taskId': 'elephant_task', 'order': 4, 'isEnabled': true}
             ]);
    }
    
    function isValidSettingsSection(settings) {
      return settings.notifications is map &&
             settings.notifications.morningReminder is bool &&
             settings.privacy is map &&
             settings.privacy.analyticsOptIn is bool;
    }
    
    function isValidSubscriptionSection(subscription) {
      return subscription.status in ['active', 'cancelled', 'expired', 'trial', 'none'] &&
             subscription.isTrialUser is bool &&
             subscription.hasUsedTrial is bool &&
             (subscription.plan == null || subscription.plan in ['weekly', 'annual']);
    }
    
    function isValidStatsSection(stats) {
      return stats.totalCompletions is number &&
             stats.currentStreak is number &&
             stats.longestStreak is number &&
             stats.averageCompletionScore is number &&
             stats.totalDaysActive is number &&
             stats.achievements is list &&
             stats.totalCompletions >= 0 &&
             stats.currentStreak >= 0 &&
             stats.longestStreak >= 0 &&
             stats.averageCompletionScore >= 0 &&
             stats.averageCompletionScore <= 100 &&
             stats.totalDaysActive >= 0;
    }
    
    function isValidMetadataSection(metadata) {
      return metadata.version is number &&
             metadata.version >= 1;
    }
    
    // Enhanced daily progress validation with MVP task validation
    function isValidDailyProgress(data) {
      return data.keys().hasAll(['userId', 'date', 'session', 'tasks', 'metadata']) &&
             data.userId == request.auth.uid &&
             isValidDateFormat(data.date) &&
             isValidSession(data.session) &&
             isValidTaskCompletions(data.tasks) &&
             isValidProgressMetadata(data.metadata);
    }
    
    function isValidDateFormat(date) {
      return date is string &&
             date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    
    function isValidSession(session) {
      return session.isCompleted is bool &&
             session.completionPercentage is number &&
             session.completionPercentage >= 0 &&
             session.completionPercentage <= 100;
    }
    
    function isValidTaskCompletions(tasks) {
      return tasks is list &&
             tasks.size() >= 4 &&
             hasAllMVPTasks(tasks) &&
             tasks.hasAll([isValidTaskCompletion]);
    }
    
    function hasAllMVPTasks(tasks) {
      let mvpTaskIds = ['drink_water', 'no_phone_usage', 'sunlight_exposure', 'elephant_task'];
      return mvpTaskIds.hasAll([taskId in tasks[].taskId]);
    }
    
    function isValidTaskCompletion(task) {
      return task.keys().hasAll(['taskId', 'name', 'category', 'plannedDuration', 'status']) &&
             task.taskId in ['drink_water', 'no_phone_usage', 'sunlight_exposure', 'elephant_task'] &&
             task.status in ['not_started', 'in_progress', 'completed', 'skipped'] &&
             task.plannedDuration is number &&
             task.plannedDuration >= 0 &&
             task.plannedDuration <= 60 &&
             isValidMVPTaskSpecific(task);
    }
    
    function isValidMVPTaskSpecific(task) {
      return (task.taskId == 'drink_water' && isValidWaterTask(task)) ||
             (task.taskId == 'no_phone_usage' && isValidNoPhoneTask(task)) ||
             (task.taskId == 'sunlight_exposure' && isValidSunlightTask(task)) ||
             (task.taskId == 'elephant_task' && isValidElephantTask(task));
    }
    
    function isValidWaterTask(task) {
      return task.category == 'hydration' &&
             (task.actualDuration == null || task.actualDuration <= 10);
    }
    
    function isValidNoPhoneTask(task) {
      return task.category == 'digital_wellness';
    }
    
    function isValidSunlightTask(task) {
      return task.category == 'health' &&
             (task.actualDuration == null || task.actualDuration <= 30);
    }
    
    function isValidElephantTask(task) {
      return task.category == 'productivity' &&
             (task.status != 'completed' || task.notes != null);
    }
    
    function isValidProgressMetadata(metadata) {
      return metadata.dataSource in ['app', 'sync', 'manual'];
    }
    
    // Enhanced subscription validation
    function isValidSubscription(data) {
      return data.keys().hasAll(['userId', 'current', 'metadata']) &&
             data.userId == request.auth.uid &&
             isValidCurrentSubscription(data.current);
    }
    
    function isValidCurrentSubscription(current) {
      return current.status in ['active', 'cancelled', 'expired', 'trial', 'none'] &&
             current.autoRenew is bool &&
             isValidTrialInfo(current.trial);
    }
    
    function isValidTrialInfo(trial) {
      return trial.isTrialUser is bool &&
             trial.hasUsedTrial is bool &&
             (trial.isTrialUser == false || trial.trialStartDate != null);
    }
    
    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && 
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId;
    }
    
    // User progress subcollection - users can only access their own progress
    match /user_progress/{userId} {
      allow read, write: if isOwner(userId);
      
      match /daily_entries/{dateString} {
        allow read, write: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDailyProgress(request.resource.data);
        allow update: if isOwner(userId) && 
                         isValidDailyProgress(request.resource.data) &&
                         request.resource.data.userId == resource.data.userId;
      }
    }
    
    // Subscriptions collection - users can only access their own subscription
    match /subscriptions/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSubscription(request.resource.data);
      allow update: if isOwner(userId) && 
                       isValidSubscription(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId;
    }
    
    // Support tickets - users can only access their own tickets
    match /support_tickets/{ticketId} {
      allow read, write: if isAuthenticated() && 
                           resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['ticketId', 'userId', 'ticket', 'userContext', 'metadata']) &&
                       request.resource.data.ticket.category in ['bug', 'feature_request', 'billing', 'general', 'technical'] &&
                       request.resource.data.ticket.priority in ['low', 'medium', 'high', 'urgent'] &&
                       request.resource.data.ticket.status in ['open', 'in_progress', 'resolved', 'closed'];
    }
    
    // App configuration - read-only for authenticated users
    match /app_config/{document} {
      allow read: if isAuthenticated();
      // Only allow admins to write (implement admin check if needed)
      allow write: if false; // For now, no client-side writes to app config
    }
    
    // Analytics events - write-only for authenticated users (their own events)
    match /analytics_events/{eventId} {
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['eventId', 'userId', 'event', 'context', 'metadata']) &&
                       request.resource.data.event.category in ['user_action', 'system', 'business', 'performance'] &&
                       request.resource.data.event.name is string &&
                       request.resource.data.context.appVersion is string &&
                       request.resource.data.context.platform in ['ios', 'android'];
      // Analytics events are write-only for privacy
      allow read: if false;
      allow update, delete: if false;
    }
    
    // Backup logs - read-only for authenticated users (system generated)
    match /backup_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false; // System generated only
    }
    
    // Query logs - system use only
    match /query_logs/{logId} {
      allow read, write: if false; // System use only
    }
  }
}